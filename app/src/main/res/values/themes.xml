<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PlusPOS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/pos_blue</item>
        <item name="colorPrimaryDark">@color/pos_blue_dark</item>
        <item name="colorPrimaryVariant">@color/pos_blue_dark</item>
        <item name="colorSecondary">@color/pos_sky</item>
        <item name="colorAccent">@color/pos_blue</item>
        <item name="colorControlActivated">@color/pos_blue</item>
        <item name="android:windowBackground">@color/pos_bg</item>
        <item name="android:textColorPrimary">@color/pos_ink</item>
        <item name="android:textColorSecondary">@color/pos_muted</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pl_navy_900</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/pl_navy_900</item>
        <!-- Police Plus Lotterie (Barlow) pou tout app la -->
        <item name="android:fontFamily">@font/pl_barlow_semibold</item>
        <item name="fontFamily">@font/pl_barlow_semibold</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PlusPOS.Dialog</item>
        <!-- Meni 3 pwen an (PopupMenu) -->
        <item name="popupMenuStyle">@style/Widget.PlusPOS.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.PlusPOS.PopupItem</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.PlusPOS.PopupItem</item>
    </style>

    <style name="Widget.PlusPOS.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation" tools:targetApi="l">8dp</item>
    </style>

    <style name="TextAppearance.PlusPOS.PopupItem" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/pos_ink</item>
        <item name="android:fontFamily">@font/pl_barlow_semibold</item>
        <item name="fontFamily">@font/pl_barlow_semibold</item>
    </style>

    <!-- ===================== BOUTON ===================== -->

    <!-- Gwo bouton "pilil" (dashboard, login, paramèt) -->
    <style name="Widget.PlusPOS.Button.Pill" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/pl_barlow_extrabold</item>
        <item name="fontFamily">@font/pl_barlow_extrabold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/pos_on_color</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@animator/press_lift</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Bouton mwayen (rapò, paramèt, chwazi Mariage/Loto4) -->
    <style name="Widget.PlusPOS.Button.Soft" parent="Widget.PlusPOS.Button.Pill">
        <item name="android:layout_height">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Ti "chip" jwèt yo (BPaire, Grap, P0–P9, Mariage, Loto4/5) -->
    <style name="Widget.PlusPOS.Button.Chip" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:minWidth">60dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/pl_barlow_extrabold</item>
        <item name="fontFamily">@font/pl_barlow_extrabold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/pos_on_color</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@animator/press_lift</item>
    </style>

    <!-- Bouton ikòn won an tèt ekran yo (retounen, efase, pataje…) -->
    <style name="Widget.PlusPOS.IconButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_icon_button</item>
    </style>

    <!-- Bouton ikòn sou ba ble fonse a (retounen…): kare blan transparan, ikòn blan -->
    <style name="Widget.PlusPOS.AppBarIcon" parent="Widget.PlusPOS.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/pl_bg_appbar_icon</item>
        <item name="android:tint">@color/pl_white</item>
        <item name="android:stateListAnimator">@animator/pl_press_scale</item>
    </style>

    <!-- Ba ble fonse anlè chak ekran (menm antèt ak akèy la) -->
    <style name="Widget.PlusPOS.AppBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:background">@drawable/pl_bg_appbar</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:elevation">6dp</item>
    </style>

    <!-- Dyalòg yo: kwen awondi, tit an italik, bouton ble -->
    <style name="ThemeOverlay.PlusPOS.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/pos_blue</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PlusPOS.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/PlusPOS.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PlusPOS.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/PlusPOS.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/PlusPOS.DialogButton</item>
    </style>
    <style name="ShapeAppearance.PlusPOS.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>
    <style name="PlusPOS.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/pl_navy_900</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">@font/pl_barlow_black_italic</item>
        <item name="fontFamily">@font/pl_barlow_black_italic</item>
    </style>
    <style name="PlusPOS.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pos_blue</item>
        <item name="android:fontFamily">@font/pl_barlow_extrabold</item>
        <item name="fontFamily">@font/pl_barlow_extrabold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ===================== TÈKS ===================== -->

    <style name="TextAppearance.PlusPOS.Title" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/pl_navy_900</item>
        <item name="android:fontFamily">@font/pl_barlow_black_italic</item>
        <item name="fontFamily">@font/pl_barlow_black_italic</item>
    </style>

    <!-- Tit blan sou ba ble fonse anlè chak ekran -->
    <style name="TextAppearance.PlusPOS.AppBarTitle" parent="TextAppearance.PlusPOS.Title">
        <item name="android:textColor">@color/pl_white</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.PlusPOS.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pos_muted</item>
        <item name="android:fontFamily">@font/pl_barlow_bold</item>
        <item name="fontFamily">@font/pl_barlow_bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Chan dat (De / A / Debut / Fin) -->
    <style name="Widget.PlusPOS.DateField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawableStart">@drawable/ic_calendar</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pos_ink</item>
        <item name="android:fontFamily">@font/pl_barlow_bold</item>
        <item name="fontFamily">@font/pl_barlow_bold</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Ba navigasyon anba a -->
    <style name="Widget.PlusPOS.NavIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="TextAppearance.PlusPOS.NavLabel" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pl_barlow_extrabold</item>
        <item name="fontFamily">@font/pl_barlow_extrabold</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <!-- ===== Boul ki soti ===== -->
    <style name="Widget.PlusPOS.DayChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_chip_day</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/pos_on_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pl_barlow_bold</item>
        <item name="fontFamily">@font/pl_barlow_bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.PlusPOS.BallColumn" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.PlusPOS.Ball" parent="">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">4dp</item>
        <item name="android:fontFamily">@font/pl_barlow_black_italic</item>
        <item name="fontFamily">@font/pl_barlow_black_italic</item>
        <item name="android:textColor">@color/pos_on_color</item>
        <item name="android:textSize">22sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#55000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Widget.PlusPOS.BallLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">@color/pos_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="Widget.PlusPOS.MiniBall" parent="">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/pl_barlow_black_italic</item>
        <item name="fontFamily">@font/pl_barlow_black_italic</item>
        <item name="android:textColor">@color/pos_on_color</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.PlusPOS.ActionTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_action_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:fontFamily">@font/pl_barlow_bold</item>
        <item name="fontFamily">@font/pl_barlow_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
