<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PlusPOS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/pos_blue</item>
        <item name="colorPrimaryDark">@color/pos_blue_dark</item>
        <item name="colorPrimaryVariant">@color/pos_blue_dark</item>
        <item name="colorSecondary">@color/pos_sky</item>
        <item name="colorAccent">@color/pos_blue</item>
        <item name="colorControlActivated">@color/pos_blue</item>
        <item name="android:windowBackground">@color/pos_bg</item>
        <item name="android:textColorPrimary">@color/pos_ink</item>
        <item name="android:textColorSecondary">@color/pos_muted</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pos_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="l">#000000</item>
        <!-- Meni 3 pwen an (PopupMenu) -->
        <item name="popupMenuStyle">@style/Widget.PlusPOS.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.PlusPOS.PopupItem</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.PlusPOS.PopupItem</item>
    </style>

    <style name="Widget.PlusPOS.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation" tools:targetApi="l">8dp</item>
    </style>

    <style name="TextAppearance.PlusPOS.PopupItem" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/pos_ink</item>
    </style>

    <!-- ===================== BOUTON ===================== -->

    <!-- Gwo bouton "pilil" (dashboard, login, paramèt) -->
    <style name="Widget.PlusPOS.Button.Pill" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/pos_on_color</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@animator/press_lift</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Bouton mwayen (rapò, paramèt, chwazi Mariage/Loto4) -->
    <style name="Widget.PlusPOS.Button.Soft" parent="Widget.PlusPOS.Button.Pill">
        <item name="android:layout_height">48dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Ti "chip" jwèt yo (BPaire, Grap, P0–P9, Mariage, Loto4/5) -->
    <style name="Widget.PlusPOS.Button.Chip" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:minWidth">60dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/pos_on_color</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@animator/press_lift</item>
    </style>

    <!-- Bouton ikòn won an tèt ekran yo (retounen, efase, pataje…) -->
    <style name="Widget.PlusPOS.IconButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_icon_button</item>
    </style>

    <!-- ===================== TÈKS ===================== -->

    <style name="TextAppearance.PlusPOS.Title" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/pos_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PlusPOS.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pos_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Chan dat (De / A / Debut / Fin) -->
    <style name="Widget.PlusPOS.DateField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawableStart">@drawable/ic_calendar</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pos_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Ba navigasyon anba a -->
    <style name="Widget.PlusPOS.NavIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="TextAppearance.PlusPOS.NavLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
</resources>
