<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/pos_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF7F9FD" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/pos_stroke" />
        </shape>
    </item>
</selector>
