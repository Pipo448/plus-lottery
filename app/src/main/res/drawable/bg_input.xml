<?xml version="1.0" encoding="utf-8"?>
<!-- Chan tèks login — kad la vin ble lè w ap tape -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/pos_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/pos_stroke" />
        </shape>
    </item>
</selector>
