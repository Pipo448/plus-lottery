<?xml version="1.0" encoding="utf-8"?>
<!-- Boul wouj (3yèm lo) — non fichye a pa chanje pou kòd la: menm boul 3D ak sit la ak panèl admin nan -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.35"
                android:centerY="0.3"
                android:gradientRadius="75%"
                android:startColor="#FF8A92"
                android:centerColor="#EF1F2E"
                android:endColor="#8E0815" />
        </shape>
    </item>
    <item android:left="9dp" android:top="6dp" android:right="22dp" android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
