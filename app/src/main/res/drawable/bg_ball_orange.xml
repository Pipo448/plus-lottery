<?xml version="1.0" encoding="utf-8"?>
<!-- Boul bolèt (orange): limyè anlè agoch pou efè 3D -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.35"
                android:centerY="0.3"
                android:gradientRadius="75%"
                android:startColor="#FFC27A"
                android:centerColor="#F5821F"
                android:endColor="#C2570A" />
        </shape>
    </item>
    <item android:left="9dp" android:top="6dp" android:right="22dp" android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
