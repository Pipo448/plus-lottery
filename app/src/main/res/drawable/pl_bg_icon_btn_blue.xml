<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#FF2558D6" android:centerColor="#FF1A4BCC" android:endColor="#FF0F37A0" />
            <stroke android:width="1dp" android:color="@color/pl_white_22" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#FF2F6DFF" android:centerColor="#FF2258E0" android:endColor="#FF1442C4" />
            <stroke android:width="1dp" android:color="@color/pl_white_22" />
        </shape>
    </item>
</selector>
