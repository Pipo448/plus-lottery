<?xml version="1.0" encoding="utf-8"?>
<!--
  NOUVÈL FICH — vèsyon 3 (design "swa").
  Tout ID ak tip view yo rete menm jan, NewFicheActivity.kt pa chanje.
  Estrikti: en-tèt ak ikòn won → ba kolòn → liy yo sou vag → panèl blan
  anba a (kwen awondi anwo) ak total, tiraj, chip jwèt, 2 gwo chan, ANTRE.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wave_blue"
    android:orientation="vertical">

    <!-- En-tèt: retounen / efase tout / pataje / enprime -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/pos_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PlusPOS.IconButton"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_blue"
            android:contentDescription="Retounen"
            android:src="@drawable/ic_back"
            android:tint="@color/pos_blue" />

        <ImageButton
            android:id="@+id/btnClearAll"
            style="@style/Widget.PlusPOS.IconButton"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/btnBack"
            android:background="@drawable/bg_icon_red"
            android:contentDescription="Efase tout"
            android:src="@drawable/ic_delete"
            android:tint="@color/pos_red" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnShare"
                style="@style/Widget.PlusPOS.IconButton"
                android:background="@drawable/bg_icon_green"
                android:contentDescription="Pataje"
                android:src="@drawable/ic_share"
                android:tint="@color/pos_green" />

            <ImageButton
                android:id="@+id/btnPrint"
                style="@style/Widget.PlusPOS.IconButton"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_amber"
                android:contentDescription="Enprime"
                android:src="@drawable/ic_print"
                android:tint="@color/pos_amber_deep" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Ba kolòn: Tiraj / Boul / Kòb -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_header_bar"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <View
            android:layout_width="44dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Tiraj"
            android:textColor="@color/pos_on_color"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Boul"
            android:textColor="@color/pos_on_color"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Kòb"
            android:textColor="@color/pos_on_color"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ZÒN LIY YO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <TextView
                        android:id="@+id/tvFicheLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="BORLETTE"
                        android:textColor="@color/pos_ink"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnEditGameLabel"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Chanje kategori"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_edit"
                        android:tint="@color/pos_red" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llLinesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- PANÈL ANBA A: Total + Tiraj + chip jwèt + chan + ANTRE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_top"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <!-- Ti manch dekoratif anlè panèl la -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_scroll_track" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:text="Total: 0.00"
            android:textColor="@color/pos_ink"
            android:textSize="19sp" />

        <!-- Chwazi tiraj -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="LT"
                android:textColor="@color/pos_on_color"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiraj"
                    android:textAppearance="@style/TextAppearance.PlusPOS.Label"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvChwaziTiraj"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="8dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="CHWAZI TIRAJ"
                    android:textColor="@color/pos_ink"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chip jwèt yo — ba defilman an anba montre gen plis -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:paddingBottom="10dp"
            android:scrollbarSize="5dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbHorizontal="@drawable/bg_scroll_thumb"
            android:scrollbarTrackHorizontal="@drawable/bg_scroll_track"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <!-- REVÈ: 35 → 53 (menm pri a) -->
                <Button
                    android:id="@+id/btnRevers"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="Revè"
                    app:backgroundTint="@color/pos_navy" />

                <Button
                    android:id="@+id/btnBPaire"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="BPaire"
                    app:backgroundTint="@color/pos_blue" />

                <Button
                    android:id="@+id/btnGrap"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="Grap"
                    android:textColor="@color/pos_on_amber"
                    app:backgroundTint="@color/pos_amber" />

                <Button
                    android:id="@+id/btnP0"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P0"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP1"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P1"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP2"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P2"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP3"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P3"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP4"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P4"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP5"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P5"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP6"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P6"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP7"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P7"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP8"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P8"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnP9"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="P9"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnMariage"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="Mariage"
                    android:textColor="@color/pos_on_amber"
                    app:backgroundTint="@color/pos_amber" />

                <Button
                    android:id="@+id/btnLoto4"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:text="Loto4"
                    app:backgroundTint="@color/pos_blue" />

                <Button
                    android:id="@+id/btnLoto5"
                    style="@style/Widget.PlusPOS.Button.Chip"
                    android:layout_marginEnd="0dp"
                    android:text="Loto5"
                    app:backgroundTint="@color/pos_blue" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Parèt SÈLMAN lè gen 2 boul borlette oswa plis sou fich la -->
        <LinearLayout
            android:id="@+id/llAutoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnMAuto"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="MAuto"
                android:textColor="@color/pos_on_amber"
                app:backgroundTint="@color/pos_amber" />

            <Button
                android:id="@+id/btnL4Auto"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="L4Auto"
                app:backgroundTint="@color/pos_green" />
        </LinearLayout>

        <!-- 2 gwo chan: Boul la / Pri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <EditText
                android:id="@+id/etBoulLa"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_big"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="Boul la"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:nextFocusForward="@id/etMontant"
                android:textColor="@color/pos_ink"
                android:textColorHint="#94A3B8"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/etMontant"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_big"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="Pri"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:textColor="@color/pos_ink"
                android:textColorHint="#94A3B8"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Parèt SÈLMAN lè 4 oswa 5 chif tape nan "Boul la":
             yon sèl klik → Maryaj, oswa opsyon 1 / 2 / 3 (oswa tou 3) -->
        <LinearLayout
            android:id="@+id/llMariageLoto4Chooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnChooseMariage"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.4"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Maryaj"
                android:textColor="@color/pos_on_amber"
                app:backgroundTint="@color/pos_amber" />

            <TextView
                android:id="@+id/tvQuickPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="sans-serif-black"
                android:text="L4"
                android:textColor="@color/pos_blue"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnOpt1"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="O1"
                app:backgroundTint="@color/pos_blue" />

            <Button
                android:id="@+id/btnOpt2"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="O2"
                app:backgroundTint="@color/pos_blue" />

            <Button
                android:id="@+id/btnOpt3"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="O3"
                app:backgroundTint="@color/pos_blue" />

            <Button
                android:id="@+id/btnOptAll"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.3"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="1·2·3"
                app:backgroundTint="@color/pos_navy" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAntre"
            style="@style/Widget.PlusPOS.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="Antre"
            app:backgroundTint="@color/pos_sky"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
