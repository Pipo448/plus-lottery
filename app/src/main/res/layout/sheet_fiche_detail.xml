<?xml version="1.0" encoding="utf-8"?>
<!-- DETAY FICH — fèy anba: antèt koulè (estati), boul ki soti, liy yo, total, aksyon -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llFicheHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_results_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:alpha="0.5"
            android:background="@drawable/bg_pill_solid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFicheDraw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/pos_on_color"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/tvFicheStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_solid"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFicheNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textColor="@color/pos_on_color"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvFicheMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/llFicheBalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Boul ki soti"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFicheBall1"
                style="@style/Widget.PlusPOS.MiniBall"
                android:background="@drawable/bg_ball_orange" />

            <TextView
                android:id="@+id/tvFicheBall2"
                style="@style/Widget.PlusPOS.MiniBall"
                android:background="@drawable/bg_ball_blue" />

            <TextView
                android:id="@+id/tvFicheBall3"
                style="@style/Widget.PlusPOS.MiniBall"
                android:background="@drawable/bg_ball_navy" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/pos_bg">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:id="@+id/llFicheLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_result_card"
                    android:orientation="vertical"
                    android:padding="12dp" />

                <!-- Total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_result_card"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Widget.PlusPOS.BallLabel" android:layout_marginTop="0dp" android:text="Total mise" />

                        <TextView
                            android:id="@+id/tvFicheTotalMise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/pos_navy"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView style="@style/Widget.PlusPOS.BallLabel" android:layout_marginTop="0dp" android:text="Total gain" />

                        <TextView
                            android:id="@+id/tvFicheTotalGain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/pos_green"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFicheNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/pos_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/pbFiche"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/pos_navy" />
    </FrameLayout>

    <!-- Aksyon yo (ajoute nan kòd la dapre estati fich la) -->
    <LinearLayout
        android:id="@+id/llFicheActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pos_surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp" />
</LinearLayout>
