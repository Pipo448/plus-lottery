<?xml version="1.0" encoding="utf-8"?>
<!-- CHACHE FICH — vèsyon 3 (design "swa"). ID yo pa chanje. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wave_blue"
    android:orientation="vertical">

    <!-- Ba anlè: ble fonse Plus Lotterie -->
    <LinearLayout style="@style/Widget.PlusPOS.AppBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PlusPOS.AppBarIcon"
            android:contentDescription="Retounen"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rechercher fiche"
            android:textAppearance="@style/TextAppearance.PlusPOS.AppBarTitle" />
    </LinearLayout>

    <!-- Ti liy koulè Plus Lotterie anba ba a -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/pl_bg_brand_line" />

    <!-- Scan + chan tikè -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pos_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/btnScan"
            style="@style/Widget.PlusPOS.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan"
            app:backgroundTint="@color/pos_blue"
            app:icon="@drawable/ic_scan"
            app:iconGravity="textStart"
            app:iconTint="@color/pos_on_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp">

            <ImageButton
                android:id="@+id/btnSearchIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Chèche"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                android:tint="@color/pos_blue" />

            <EditText
                android:id="@+id/etTicket"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Entrer Ticket"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/pos_ink"
                android:textColorHint="#94A3B8"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rezilta -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:overScrollMode="never"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:textColor="@color/pos_ink"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
