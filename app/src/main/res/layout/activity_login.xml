<?xml version="1.0" encoding="utf-8"?>
<!-- LOGIN — vèsyon 3 (design "swa"). ID yo pa chanje. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wave_blue"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_logo_tile"
            android:elevation="6dp"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-black"
            android:text="Plus"
            android:textColor="@color/pos_navy"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.35"
            android:text="POS"
            android:textColor="@color/pos_blue"
            android:textSize="13sp" />

        <!-- Kat login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Konekte nan kont ou"
                android:textAppearance="@style/TextAppearance.PlusPOS.Title"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="username"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="12dp"
                android:hint="Idantifyan"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/pos_ink"
                android:textColorHint="#94A3B8"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="6dp"
                android:autofillHints="password"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:hint="Modpas"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/pos_ink"
                android:textColorHint="#94A3B8"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/pos_red"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Erè egzanp" />

            <Button
                android:id="@+id/btnLogin"
                style="@style/Widget.PlusPOS.Button.Pill"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Konekte"
                app:backgroundTint="@color/pos_blue" />
        </LinearLayout>

        <!-- Device ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card_glass"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID"
                android:textAppearance="@style/TextAppearance.PlusPOS.Label" />

            <TextView
                android:id="@+id/tvDeviceIdValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:textColor="@color/pos_red"
                android:textIsSelectable="true"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="3218bb5334cec2d5" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Version 1.0.0 @PlusGroup"
            android:textColor="@color/pos_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
