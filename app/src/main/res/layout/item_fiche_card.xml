<?xml version="1.0" encoding="utf-8"?>
<!-- Kat yon fich (Fich mwen yo / Fich gagnant): ba koulè estati agoch -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_fiche_card"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:orientation="horizontal">

    <View
        android:id="@+id/vCardStrip"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_solid" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCardDraw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/pl_barlow_bold"
                android:maxLines="1"
                android:textColor="@color/pos_navy"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_solid"
                android:fontFamily="@font/pl_barlow_bold"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCardMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pos_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCardBalls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/pos_ink_soft"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical|end"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvCardMise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pl_barlow_bold"
            android:textColor="@color/pos_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCardGain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pl_barlow_black_italic"
            android:textColor="@color/pos_green"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
