<?xml version="1.0" encoding="utf-8"?>
<!-- PARAMÈT — vèsyon 4 "Plus Lotterie": ba ble anlè + bouton degrade. ID yo pa chanje. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wave_blue"
    android:orientation="vertical">

    <!-- Ba anlè: ble fonse Plus Lotterie -->
    <LinearLayout style="@style/Widget.PlusPOS.AppBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PlusPOS.AppBarIcon"
            android:contentDescription="Retounen"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Paramèt"
            android:textAppearance="@style/TextAppearance.PlusPOS.AppBarTitle" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/pl_bg_brand_line" />

    <!-- Bouton aksyon anlè -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pos_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKont"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="Kont $"
                app:backgroundTint="@color/pos_green" />

            <Button
                android:id="@+id/btnTiraj"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Tiraj"
                app:backgroundTint="@color/pos_blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBoulKiSoti"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="Boul ki soti"
                android:textColor="@color/pos_on_amber"
                app:backgroundTint="@color/pos_amber"
                app:rippleColor="#1F000000" />

            <Button
                android:id="@+id/btnMizajou"
                style="@style/Widget.PlusPOS.Button.Soft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Mizajou"
                app:backgroundTint="@color/pos_red" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pl_navy_800"
        android:fontFamily="@font/pl_barlow_bold"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:padding="9dp"
        android:text="Version : 1.0.0 @PlusGroup"
        android:textColor="@color/pos_on_color"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/llSettingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp" />
        </FrameLayout>
    </ScrollView>
</LinearLayout>
