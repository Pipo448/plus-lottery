<?xml version="1.0" encoding="utf-8"?>
<!--
  DASHBOARD — vèsyon 4 (konpak: tout bagay antre nan ekran an san woule
  sou POS SUNMI ak telefòn; ScrollView la rete sèlman pou ti ekran).
  Gwosè a ka chanje nan Paramèt → Gwosè ekran.
  DASHBOARD — vèsyon 3 (design "swa").
  Tout ID yo rete EGZAKTEMAN menm jan, kidonk DashboardActivity.kt pa chanje.
  Sa ki chanje: bouton won ak lonbraj dous, mak la nan yon ti kare blan,
  kat balans ak separasyon fen, bouton pilil ak animasyon lè w peze,
  ba anba a ak ikòn (Bolèt / Paramèt).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_wave_blue">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ba wo a: enprimant / mesaj / meni -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/btnPrinter"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/pos_green"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:elevation="5dp"
                    android:stateListAnimator="@animator/press_lift"
                    android:contentDescription="Enprimant"
                    android:src="@drawable/ic_print"
                    android:tint="@color/pos_on_color" />

                <ImageButton
                    android:id="@+id/btnMail"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_toEndOf="@id/btnPrinter"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/pos_blue"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:elevation="5dp"
                    android:stateListAnimator="@animator/press_lift"
                    android:contentDescription="Notifikasyon"
                    android:src="@drawable/ic_mail"
                    android:tint="@color/pos_on_color" />

                <!-- Kantite mesaj ki poko li (Bwat mesaj) -->
                <TextView
                    android:id="@+id/tvMailBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_alignTop="@id/btnMail"
                    android:layout_alignEnd="@id/btnMail"
                    android:layout_marginTop="-4dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/bg_badge_dot"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="@color/pos_on_color"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/pos_amber"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:elevation="5dp"
                    android:stateListAnimator="@animator/press_lift"
                    android:contentDescription="Meni"
                    android:src="@drawable/ic_more_dots"
                    android:tint="@color/pos_on_amber" />
            </RelativeLayout>

            <!-- Mak la. Pou mete logo pa tenant: ranplase @drawable/ic_launcher
                 ak fichye logo a (res/drawable/logo_xxx.png) oswa chaje l
                 dinamikman nan DashboardActivity.kt. -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_logo_tile"
                android:elevation="4dp"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher" />
            </FrameLayout>

            <!-- Salut + rafrechi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSalut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Salut"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/pos_ink"
                    android:textSize="19sp" />

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Rafrechi"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/pos_ink_soft" />
            </LinearLayout>

            <!-- Kat balans -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_rounded"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_vertical"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="0.00"
                            android:textColor="@color/pos_ink"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Balance"
                            android:textAppearance="@style/TextAppearance.PlusPOS.Label" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCreditVente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Illimité"
                            android:textColor="@color/pos_ink"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Crédit de vente"
                            android:textAppearance="@style/TextAppearance.PlusPOS.Label" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="28dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/pos_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLimiteGain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Illimité"
                        android:textColor="@color/pos_ink"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Limite gain"
                        android:textAppearance="@style/TextAppearance.PlusPOS.Label" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bouton prensipal yo: yo pran espas ki rete a, yo rete santre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <Button
                    android:id="@+id/btnNouvelFich"
                    style="@style/Widget.PlusPOS.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="Nouvèl fich"
                    app:backgroundTint="@color/pos_green" />

                <Button
                    android:id="@+id/btnChacheFich"
                    style="@style/Widget.PlusPOS.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="Chache fich"
                    app:backgroundTint="@color/pos_blue" />

                <Button
                    android:id="@+id/btnFichMwenYo"
                    style="@style/Widget.PlusPOS.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="Fich mwen yo"
                    android:textColor="@color/pos_on_amber"
                    app:backgroundTint="@color/pos_amber"
                    app:rippleColor="#1F000000" />

                <Button
                    android:id="@+id/btnRapo"
                    style="@style/Widget.PlusPOS.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="4dp"
                    android:text="Rapò"
                    app:backgroundTint="@color/pos_red" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:text="Plus Group Lottery"
                android:textColor="@color/pos_muted"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Ba anba a: Bolèt (aktif) / Paramèt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabBolet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                style="@style/Widget.PlusPOS.NavIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_clipboard"
                android:tint="@color/pos_on_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bolèt"
                android:textAppearance="@style/TextAppearance.PlusPOS.NavLabel"
                android:textColor="@color/pos_on_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabParamet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                style="@style/Widget.PlusPOS.NavIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                android:tint="@color/pos_on_color_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paramèt"
                android:textAppearance="@style/TextAppearance.PlusPOS.NavLabel"
                android:textColor="@color/pos_on_color_dim" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
