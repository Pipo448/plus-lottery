<?xml version="1.0" encoding="utf-8"?>
<!-- ENPRIMANT / KONT — vèsyon 4 "Plus Lotterie". ID yo pa chanje. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wave_blue"
    android:orientation="vertical">

    <!-- Ba anlè: ble fonse Plus Lotterie -->
    <LinearLayout style="@style/Widget.PlusPOS.AppBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PlusPOS.AppBarIcon"
            android:contentDescription="Retounen"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Enprimant"
            android:textAppearance="@style/TextAppearance.PlusPOS.AppBarTitle" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/pl_bg_brand_line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/pl_bg_icon_btn_blue"
            android:contentDescription="@null"
            android:padding="14dp"
            android:src="@drawable/pl_ic_print" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enprimant"
            android:textAppearance="@style/TextAppearance.PlusPOS.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Konfigire enprimant ou epi teste l."
            android:textColor="@color/pos_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPrinterStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_field"
            android:gravity="center"
            android:padding="12dp"
            android:text="Enprimant: ap konekte..."
            android:textColor="@color/pos_ink_soft"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnChoosePrinter"
            style="@style/Widget.PlusPOS.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="Chwazi enprimant Bluetooth"
            android:textColor="@color/pos_on_amber"
            app:backgroundTint="@color/pos_amber"
            app:icon="@drawable/ic_bluetooth"
            app:iconGravity="textStart"
            app:iconTint="@color/pos_on_amber"
            app:rippleColor="#1F000000" />

        <Button
            android:id="@+id/btnTestPrint"
            style="@style/Widget.PlusPOS.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="Tès enprimant"
            app:backgroundTint="@color/pos_blue"
            app:icon="@drawable/ic_print"
            app:iconGravity="textStart"
            app:iconTint="@color/pos_on_color" />

        <Button
            android:id="@+id/btnLogout"
            style="@style/Widget.PlusPOS.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Dekonekte"
            app:backgroundTint="@color/pos_red"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="@color/pos_on_color" />
    </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
